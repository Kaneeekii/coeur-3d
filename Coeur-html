<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cœur 3D – Kaneeekii</title>
</head>
<body>
<canvas id="c"></canvas>

<style>
body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #000;
}
canvas {
  display: block;
  filter: drop-shadow(0 0 4px #ff2d75)
    drop-shadow(0 0 14px #ff2d75);
}
</style>

<script>
const c = document.getElementById("c");
const ctx = c.getContext("2d");
ctx.globalCompositeOperation = "lighter";
const W = c.width = 300;
const H = c.height = 260;
const pts = [];
const dust = [];
let a = 0;

for (let i = 0; i < 2600; i++) {
  const t = Math.random() * Math.PI * 2;
  const z = Math.random() * 2 - 1;
  const r = Math.random() ** 0.3;
  const k = Math.sqrt(1 - z * z) * r;
  const x = 16 * Math.sin(t) ** 3;
  const y = 13 * Math.cos(t)
    - 5 * Math.cos(2 * t)
    - 2 * Math.cos(3 * t)
    - Math.cos(4 * t);
  pts.push({ x: x*k, y: -y*k, z: z*6*r,
    ph: Math.random() * 7 });
}

for (let i = 0; i < 70; i++) {
  dust.push({ x: Math.random() * W,
    y: Math.random() * H, v: Math.random() + .3 });
}

function draw(time) {
  ctx.clearRect(0, 0, W, H);
  a += 0.012;
  const t = (time % 1200) / 1200;
  const s = 6 + Math.exp(-t * 8);
  const cos = Math.cos(a), sin = Math.sin(a);

  for (const p of pts) {
    const o = 1 + 0.5 * Math.sin(time / 900 + p.ph) ** 8;
    const x = (p.x * cos - p.z * sin) * o;
    const z = (p.x * sin + p.z * cos) * o;
    const f = 300 / (300 + z * 7);
    const X = W / 2 + x * s * f;
    const Y = H / 2 - 16 + p.y * o * s * f;
    ctx.globalAlpha = (f - 0.75) * 2 / o;
    ctx.fillStyle = z < 0 ? "#ffd1e1" : "#ff2d75";
    ctx.fillRect(X, Y, 1.8, 1.8);
  }

  ctx.globalAlpha = 0.6;
  ctx.fillStyle = "#ff7ab6";
  for (const d of dust) {
    d.y = d.y < 0 ? H : d.y - d.v;
    ctx.fillRect(d.x, d.y, 1.5, 1.5);
  }
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

</body>
</html>
